# shared password for the web UI / API
APP_PASSWORD=change-me
# used by docker compose
DB_PASSWORD=bank
# used by `npm run dev` (db from `npm run db`)
DATABASE_URL=postgres://bank:bank@localhost:5432/bank
# integration tests TRUNCATE tables -> use a throw-away database, never the real one
TEST_DATABASE_URL=postgres://bank:bank@localhost:5432/bank_test
